# Secrets and generated certificates — never commit.
infra/.env
infra/certs/out/
infra/keycloak/realm/
infra/demo-credentials.txt
*.key
*.pem

# Model weights are installed offline (scripts/fetch_models.md); only the registry is tracked.
models/*
!models/registry.yaml
!models/README.md

# Build / tool output
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/
.pytest_cache/
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
offline-bundle/

# Phase 4 datasets are supplied locally, never committed
datasets/*
!datasets/README.md

# Catch-all for env files anywhere (e.g. a future frontend/.env)
.env
.env.*
!.env.example
*.p12
*.pfx

# Python envs / test output
.venv/
venv/
*.egg-info/
.coverage
htmlcov/
*.log

# Editor / OS / local tool settings
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json
